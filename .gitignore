# =========================================================
# Kchess
# Keep source code and required runtime assets.
# Ignore generated builds, caches, local data and secrets.
# =========================================================

# Windows / OS
.DS_Store
Thumbs.db
Desktop.ini

# IDE
.idea/
.vscode/
.vs/
*.iml
*.code-workspace
*.suo
*.user
*.userosscache
*.sln.docstates

# Flutter / Dart
flutter_app/.dart_tool/
flutter_app/.packages
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.pub/
flutter_app/.pub-cache/
flutter_app/build/
flutter_app/coverage/
flutter_app/pubspec_overrides.yaml

# Windows Flutter generated files
flutter_app/windows/flutter/ephemeral/

# Android generated files
flutter_app/android/.gradle/
flutter_app/android/local.properties
flutter_app/android/**/build/
flutter_app/android/captures/

# Android signing secrets
**/key.properties
**/*.jks
**/*.keystore

# Native / CMake generated files
native/build/
native/out/
native/.cache/
# Stable local Stockfish libraries survive `flutter clean`; large build caches live in %LOCALAPPDATA%.
native/prebuilt/windows/

**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/build.ninja
**/.ninja_deps
**/.ninja_log

# Compiled files
*.exe
*.dll
*.pdb
*.obj
*.o
*.a
*.lib
*.exp
*.ilk

# Local databases / runtime data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Logs / temporary files
*.log
logs/
tmp/
temp/
.cache/

# Secrets
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx


# Local AI provider secrets / usage state
/secrets/gemini_api_key.txt
/secrets/gemini_usage.json

# Archives / update packages
*.zip
*.7z
*.rar

# Backup files
*.bak
*.backup
*.old
*~

# Do NOT ignore pubspec.lock for an application

# Temporary Kchess update folders
Kchess_Update_*/

# Python developer/training caches and generated interpreter artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editor/patch scratch residue
*.tmp
*.swp
*.swo
*.orig
*.rej
# Prevent accidental nested project copies
/Kchess/
/flutter_app/flutter_app/


# Local coding-agent scratch artifacts
/codex_changes.patch
/codex_status.txt

# =========================================================
# Repository hygiene: private/local dependencies and AI assets
# =========================================================

# Entire local secret store is private. Keep examples/templates elsewhere.
/secrets/
**/.secrets/
**/secrets.local/
**/credentials.json
**/service-account*.json
**/*credentials*.json

# Local third-party payloads are intentionally not distributed in update ZIPs.
# Dependency/model manifests and documentation belong in source-controlled
# locations outside this local payload tree.
/third_party/


# Model weights / compiled inference artifacts must stay local unless a future
# release explicitly moves them to a dedicated artifact/LFS workflow.

# Common local ML/download caches.
**/.huggingface/
**/.torch/
**/.cache/huggingface/
**/*.key
**/*.ppk
**/id_rsa
**/id_ed25519
**/token.json
**/oauth*.json
